<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaFichas.Pages.NotificacionesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:IdermaFichas.Models">

    <Grid Padding="24,8,24,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TituloPaginaStyle}" Text="Notificaciones" />
                <TextBlock
                    Style="{StaticResource SubtituloPaginaStyle}"
                    Text="Solicitudes de clínica. Al aceptar se registra la salida en Registro; al denegar se pide un motivo." />
                <TextBlock x:Name="TextoConteo" Opacity="0.72" Text="0 notificaciones" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button Click="ExportarExcel_Click" Content="Exportar Excel" />
                <Button Click="ExportarPdf_Click" Content="Exportar PDF" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="BarraEstado"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False" />

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="CajaBusqueda"
                PlaceholderText="Buscar por folio, enfermera, producto o motivo"
                TextChanged="CajaBusqueda_TextChanged" />
            <ComboBox
                x:Name="ComboEstado"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                SelectionChanged="Filtro_Changed" />
        </Grid>

        <Grid Grid.Row="3">
            <ListView
                x:Name="ListaNotificaciones"
                IsItemClickEnabled="False"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SolicitudClinica">
                        <Border
                            Padding="14,10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="0">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Folio}" />
                                        <TextBlock
                                            Opacity="0.72"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind FechaTexto}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Border
                                            Padding="8,2"
                                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            Visibility="{x:Bind Urgente}">
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Urgente" />
                                        </Border>
                                        <Border
                                            Padding="8,2"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="{ThemeResource ControlCornerRadius}">
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind EstadoTexto, Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    Grid.Row="1"
                                    Opacity="0.85"
                                    Text="{x:Bind Resumen}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Opacity="0.72"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Detalle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Row="3"
                                    Opacity="0.8"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ResumenRespuesta, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind EstaRespondida, Mode=OneWay}" />

                                <StackPanel
                                    Grid.Row="4"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind EstaPendiente, Mode=OneWay}">
                                    <Button
                                        Click="Aceptar_Click"
                                        Content="Aceptar"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button Click="Denegar_Click" Content="Denegar" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Name="TextoVacio"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.7"
                Text="Aún no hay notificaciones de la clínica."
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
