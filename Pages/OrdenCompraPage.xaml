<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaFichas.Pages.OrdenCompraPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IdermaFichas.Pages">

    <Grid Padding="24,8,24,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TituloPaginaStyle}" Text="Orden de compra" />
            <TextBlock
                Style="{StaticResource SubtituloPaginaStyle}"
                Text="Escriba un producto o un proveedor. Al elegirlo se muestran los productos de ese proveedor para marcar y generar la orden." />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <Grid VerticalAlignment="Center" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox
                    x:Name="CajaBusqueda"
                    MinHeight="32"
                    VerticalAlignment="Center"
                    PlaceholderText="Escriba producto (código o nombre) o proveedor"
                    QueryIcon="Find"
                    TextChanged="CajaBusqueda_TextChanged"
                    SuggestionChosen="CajaBusqueda_SuggestionChosen"
                    QuerySubmitted="CajaBusqueda_QuerySubmitted">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="local:SugerenciaOrdenCompra">
                            <StackPanel Spacing="1" Padding="0,4">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Titulo}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Opacity="0.68" FontSize="12" Text="{x:Bind Detalle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
                <ComboBox
                    x:Name="ComboArea"
                    Grid.Column="1"
                    MinHeight="32"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="Área"
                    SelectionChanged="Area_Changed" />
                <ComboBox
                    x:Name="ComboOrden"
                    Grid.Column="2"
                    MinHeight="32"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="Ordenar"
                    SelectionChanged="Filtros_Changed" />
                <ComboBox
                    x:Name="ComboAnio"
                    Grid.Column="3"
                    MinHeight="32"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="Año"
                    SelectionChanged="Periodo_Changed" />
                <Button
                    x:Name="BotonCambiarProveedor"
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Click="CambiarProveedor_Click"
                    Content="Cambiar"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Quita el proveedor elegido y vuelve a buscar." />
                <Button
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Click="LimpiarFiltros_Click"
                    Content="Limpiar filtros" />
            </Grid>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Opacity="0.75" Text="Meses:" />
                <ScrollViewer
                    Grid.Column="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel x:Name="PanelMeses" Orientation="Horizontal" Spacing="4" />
                        <Button VerticalAlignment="Center" Click="TodosMeses_Click" Content="Todos los meses" />
                        <ToggleButton
                            x:Name="ChipUltimos3"
                            VerticalAlignment="Center"
                            Click="AtajoMeses_Click"
                            Tag="3"
                            Content="Últimos 3 meses" />
                        <ToggleButton
                            x:Name="ChipUltimos6"
                            VerticalAlignment="Center"
                            Click="AtajoMeses_Click"
                            Tag="6"
                            Content="Últimos 6 meses" />
                    </StackPanel>
                </ScrollViewer>
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Opacity="0.75"
                    Text="Rango:" />
                <ComboBox
                    x:Name="ComboMesDesde"
                    Grid.Column="3"
                    MinHeight="32"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="Desde"
                    SelectionChanged="RangoMeses_Changed" />
                <ComboBox
                    x:Name="ComboMesHasta"
                    Grid.Column="4"
                    MinHeight="32"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="Hasta"
                    SelectionChanged="RangoMeses_Changed" />
                <TextBlock
                    x:Name="TextoPeriodo"
                    Grid.Column="5"
                    MinWidth="120"
                    VerticalAlignment="Center"
                    Opacity="0.72"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="ComboStock"
                MinHeight="32"
                HorizontalAlignment="Stretch"
                PlaceholderText="Stock"
                SelectionChanged="Filtros_Changed" />
            <ComboBox
                x:Name="ComboCaducidad"
                Grid.Column="1"
                MinHeight="32"
                HorizontalAlignment="Stretch"
                PlaceholderText="Caducidad"
                SelectionChanged="Filtros_Changed" />
            <ComboBox
                x:Name="ComboCategoria"
                Grid.Column="2"
                MinHeight="32"
                HorizontalAlignment="Stretch"
                PlaceholderText="Categoría"
                SelectionChanged="Filtros_Changed" />
            <ComboBox
                x:Name="ComboUbicacion"
                Grid.Column="3"
                MinHeight="32"
                HorizontalAlignment="Stretch"
                PlaceholderText="Ubicación"
                SelectionChanged="Filtros_Changed" />
            <ComboBox
                x:Name="ComboLote"
                Grid.Column="4"
                MinHeight="32"
                HorizontalAlignment="Stretch"
                PlaceholderText="Lote"
                SelectionChanged="Filtros_Changed" />
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TituloLista"
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                Text="Productos"
                TextWrapping="Wrap" />
            <Button
                Grid.Column="1"
                Click="GenerarOrden_Click"
                Content="Generar orden de compra"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="Abre la orden mensual de los productos marcados. El consumo usa el mes, el rango o los últimos meses elegidos." />
            <Button
                Grid.Column="2"
                Click="EditarBorradores_Click"
                Content="Editar borradores"
                ToolTipService.ToolTip="Abre las órdenes en borrador para agregar más productos del inventario." />
            <Button
                Grid.Column="3"
                Click="VerAnteriores_Click"
                Content="Órdenes anteriores"
                ToolTipService.ToolTip="Descarga otra vez las órdenes ya exportadas, en PDF o Excel." />
        </Grid>

        <Grid Grid.Row="4">
            <StackPanel
                x:Name="PanelVacio"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                MaxWidth="420">
                <FontIcon FontSize="36" Glyph="&#xE721;" Opacity="0.45" HorizontalAlignment="Center" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    TextAlignment="Center"
                    Text="Busque un producto o proveedor" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Opacity="0.7"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Text="La lista de productos aparece cuando elige una sugerencia. Si elige un producto, se muestran todos los del mismo proveedor." />
            </StackPanel>

            <Grid x:Name="PanelLista" RowSpacing="8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton
                        x:Name="BotonModoSeleccionar"
                        Click="ModoSeleccionar_Click"
                        ToolTipService.ToolTip="Con el modo activo, el clic marca productos. Ctrl añade o quita uno. Mayús marca un rango.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8B3;" />
                            <TextBlock x:Name="TextoModoSeleccionar" Text="Seleccionar" />
                        </StackPanel>
                    </ToggleButton>
                    <DropDownButton
                        Grid.Column="1"
                        ToolTipService.ToolTip="Marca o desmarca la lista visible: todas, ninguna, cruzada o armonía.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8A5;" />
                            <TextBlock Text="Marcar lista" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="SeleccionarTodas_Click" Text="Seleccionar todas" />
                                <MenuFlyoutItem Click="DeseleccionarTodas_Click" Text="Deseleccionar todas" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="SeleccionarCruzada_Click" Text="Selección cruzada (una sí, una no)" />
                                <MenuFlyoutItem Click="SeleccionarArmonia_Click" Text="Selección armonía (dos sí, una no)" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <TextBlock
                        x:Name="ResumenMarcas"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Opacity="0.7"
                        TextWrapping="Wrap" />
                </Grid>
                <ListView
                    x:Name="ListaProductos"
                    Grid.Row="1"
                    IsItemClickEnabled="True"
                    ItemClick="ListaProductos_ItemClick"
                    KeyDown="ListaProductos_KeyDown"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:OrdenProductoItem">
                            <Grid Padding="4,8" ColumnSpacing="12">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Click="VerEnCatalogo_Click" Tag="{x:Bind Id}" Text="Ver en el Inventario" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    MinWidth="32"
                                    MinHeight="32"
                                    Padding="4"
                                    VerticalAlignment="Center"
                                    Click="MarcaFicha_Click"
                                    IsChecked="{x:Bind EstaMarcada, Mode=TwoWay}"
                                    Tapped="MarcaFicha_Tapped"
                                    Tag="{x:Bind Id}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Codigo}" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Nombre}" TextWrapping="Wrap" />
                                    <TextBlock Opacity="0.65" Text="{x:Bind Resumen}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind StockTexto}" />
                                <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{x:Bind ConsumoTexto}" />
                                <TextBlock
                                    Grid.Column="5"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind PrecioTexto}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <InfoBar
            x:Name="BarraAviso"
            Grid.Row="5"
            IsClosable="True"
            IsOpen="False" />

        <TeachingTip
            x:Name="TipProveedorUnico"
            Title="Un solo proveedor"
            Subtitle="Solo se puede sacar órdenes de compra con un solo proveedor. Filtre o marque productos del mismo proveedor."
            PreferredPlacement="Bottom"
            IsLightDismissEnabled="True"
            CloseButtonContent="Entendido"
            CloseButtonClick="TipProveedorUnico_CloseButtonClick"
            Closed="TipProveedorUnico_Closed">
            <TeachingTip.IconSource>
                <FontIconSource Glyph="&#xE8FD;" />
            </TeachingTip.IconSource>
        </TeachingTip>
    </Grid>
</Page>
