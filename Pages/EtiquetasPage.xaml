<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaFichas.Pages.EtiquetasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:IdermaFichas.Models"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid MaxWidth="1280" Padding="32,20,32,32" RowSpacing="16" ColumnSpacing="16" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.ColumnSpan="2" Spacing="6">
                <TextBlock
                    Opacity="0.7"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="ÁREA LOGÍSTICA" />
                <TextBlock x:Name="TituloPagina" Style="{StaticResource TituloPaginaStyle}" Text="Generador de etiquetas" />
                <TextBlock
                    Style="{StaticResource SubtituloPaginaStyle}"
                    Text="Adjunte un Excel con la estructura obligatoria, elija el tipo de código y la cuadrícula. A la derecha verá cómo queda el formato de cada etiqueta." />
            </StackPanel>

            <InfoBar
                x:Name="BarraEstado"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                IsClosable="True"
                IsOpen="False" />

            <StackPanel Grid.Row="2" Spacing="16">
                <Border Padding="20" CornerRadius="12">
                    <Border.Background>
                        <SolidColorBrush Color="{ThemeResource CardBackgroundFillColorDefault}" />
                    </Border.Background>
                    <StackPanel Spacing="12">
                        <TextBlock FontWeight="SemiBold" Text="Archivo de productos" />
                        <TextBlock
                            Opacity="0.72"
                            Text="La primera fila debe ser: CÓDIGO · ÁREA · PRODUCTO · CANTIDAD. No se imprime una sola vez por producto: si una fila tiene 8, se generan 8 etiquetas iguales de ese código. Si tiene 0, se omite."
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Click="AdjuntarExcel_Click"
                                Content="Adjuntar Excel"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button Click="Plantilla_Click" Content="Descargar plantilla" />
                            <Button Click="PruebaImpresion_Click" Content="Prueba de impresión" />
                        </StackPanel>
                        <TextBlock x:Name="NombreArchivo" Opacity="0.75" Text="Ningún archivo adjunto." TextWrapping="Wrap" />
                        <TextBlock x:Name="ResumenArchivo" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="12">
                    <Border.Background>
                        <SolidColorBrush Color="{ThemeResource CardBackgroundFillColorDefault}" />
                    </Border.Background>
                    <StackPanel Spacing="14">
                        <TextBlock FontWeight="SemiBold" Text="Tipo de etiqueta y cuadrícula" />

                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource EtiquetaCampoStyle}" Text="Tipo de código" />
                                <ComboBox
                                    x:Name="ComboTipo"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="Opciones_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Style="{StaticResource EtiquetaCampoStyle}" Text="Tamaño de hoja" />
                                <ComboBox
                                    x:Name="ComboHoja"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="Opciones_Changed" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Spacing="4">
                                <TextBlock Style="{StaticResource EtiquetaCampoStyle}" Text="Etiquetas por fila (columnas)" />
                                <NumberBox
                                    x:Name="CajaColumnas"
                                    Maximum="8"
                                    Minimum="1"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Inline"
                                    Value="3"
                                    ValueChanged="Number_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                <TextBlock Style="{StaticResource EtiquetaCampoStyle}" Text="Etiquetas por columna (filas)" />
                                <NumberBox
                                    x:Name="CajaFilas"
                                    Maximum="16"
                                    Minimum="1"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Inline"
                                    Value="8"
                                    ValueChanged="Number_Changed" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Spacing="4">
                                <TextBlock Style="{StaticResource EtiquetaCampoStyle}" Text="Disposición" />
                                <ComboBox
                                    x:Name="ComboDisposicion"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="Opciones_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4" VerticalAlignment="Bottom">
                                <ToggleSwitch
                                    x:Name="ToggleGuiaCorte"
                                    OffContent="Sin guía de corte"
                                    OnContent="Con guía de corte"
                                    Toggled="GuiaCorte_Toggled" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="6">
                                <TextBlock x:Name="TextoTamano" Style="{StaticResource EtiquetaCampoStyle}" Text="Tamaño del código: 20 mm" />
                                <Slider
                                    x:Name="SliderTamano"
                                    Maximum="70"
                                    Minimum="10"
                                    TickFrequency="10"
                                    TickPlacement="Outside"
                                    Value="20"
                                    ValueChanged="SliderTamano_ValueChanged" />
                                <TextBlock Opacity="0.65" Text="Mínimo 10 mm · máximo 70 mm. Si no cabe en la celda, se reduce automáticamente." TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="ResumenOpciones" Opacity="0.8" TextWrapping="Wrap" />
                        <Button
                            x:Name="BotonGenerar"
                            Click="Generar_Click"
                            Content="Generar etiquetas (PDF)"
                            Style="{StaticResource AccentButtonStyle}" />
                        <StackPanel x:Name="PanelProgreso" Spacing="6" Visibility="Collapsed">
                            <TextBlock x:Name="TextoProgreso" Text="Generando etiquetas…" TextWrapping="Wrap" />
                            <ProgressBar
                                x:Name="BarraProgreso"
                                Height="10"
                                Maximum="100"
                                Minimum="0"
                                ShowPaused="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border
                Grid.Row="2"
                Grid.Column="1"
                Padding="20"
                VerticalAlignment="Stretch"
                CornerRadius="12">
                <Border.Background>
                    <SolidColorBrush Color="{ThemeResource CardBackgroundFillColorDefault}" />
                </Border.Background>
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" Text="Vista previa" />
                    <TextBlock
                        x:Name="PreviewFormato"
                        Opacity="0.72"
                        TextWrapping="Wrap" />
                    <Grid>
                        <Rectangle
                            x:Name="GuiaPreview"
                            Stroke="#C5C5C5"
                            StrokeDashArray="3,2"
                            StrokeThickness="1"
                            Visibility="Collapsed" />
                        <Border x:Name="MarcoPreview" Background="White" Padding="8,6">
                            <Grid x:Name="CajaPreviewEtiqueta" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Image
                                    x:Name="ImagenPreview"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    HorizontalAlignment="Center"
                                    Stretch="Uniform" />
                                <TextBlock
                                    x:Name="PreviewCodigo"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="Black"
                                    LineHeight="16"
                                    LineStackingStrategy="BlockLineHeight"
                                    Text="CDB_002"
                                    TextAlignment="Center" />
                                <TextBlock
                                    x:Name="PreviewProducto"
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,4,0,0"
                                    MaxWidth="160"
                                    HorizontalAlignment="Center"
                                    FontSize="9"
                                    FontWeight="Bold"
                                    Foreground="Black"
                                    LineHeight="11"
                                    LineStackingStrategy="BlockLineHeight"
                                    Text="MONALISA (HARD TYPE) FUCSIA"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </Grid>
                    <TextBlock
                        x:Name="PreviewCuadricula"
                        Opacity="0.65"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Grid.Row="3"
                Grid.ColumnSpan="2"
                Padding="20"
                CornerRadius="12">
                <Border.Background>
                    <SolidColorBrush Color="{ThemeResource CardBackgroundFillColorDefault}" />
                </Border.Background>
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="Productos del Excel" />
                    <ListView
                        x:Name="ListaProductos"
                        MaxHeight="280"
                        SelectionMode="None">
                        <ListView.Header>
                            <Grid Padding="8,4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Opacity="0.7" Text="Código" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Opacity="0.7" Text="Área" />
                                <TextBlock Grid.Column="2" FontWeight="SemiBold" Opacity="0.7" Text="Producto" />
                                <TextBlock Grid.Column="3" FontWeight="SemiBold" Opacity="0.7" Text="Se imprimen" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FilaEtiqueta">
                                <Grid Padding="8,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Codigo}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Area}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Producto}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="{x:Bind ResumenCantidad}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
