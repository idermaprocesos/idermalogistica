<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaFichas.Pages.ProveedoresPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IdermaFichas.Pages">

    <Page.Resources>
        <DataTemplate x:Key="CanalDatoPlantilla">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Image
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Source="{Binding Icono}"
                    Stretch="Uniform" />
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{Binding Titulo}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,8,24,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="TituloPagina" Style="{StaticResource TituloPaginaStyle}" Text="Proveedores" />
                <TextBlock
                    Style="{StaticResource SubtituloPaginaStyle}"
                    Text="RUC, razón social, datos bancarios, tiempo de entrega y acuerdo de compra mínima, junto con WhatsApp, web, redes y notas. Califique y filtre por el mes o el año en que se agregaron."
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="TextoConteo"
                    Opacity="0.72"
                    Text="0 proveedores" />
            </StackPanel>
            <StackPanel
                Grid.Row="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button Click="TraerProductos_Click" Content="Actualizar desde fichas" />
                <Button Click="BuscarSimilitudes_Click" Content="Buscar similitudes" />
                <Button
                    x:Name="BotonRevertirSimilitud"
                    Click="RevertirUltimoCambio_Click"
                    Content="Revertir último cambio"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Deshace el último reemplazo de similitudes (proveedores y fichas)." />
                <ToggleButton
                    x:Name="BotonModoSeleccionar"
                    Click="ModoSeleccionar_Click"
                    Content="Seleccionar"
                    ToolTipService.ToolTip="Active el modo para marcar proveedores y borrarlos en grupo." />
                <Button
                    x:Name="BotonSeleccionarTodos"
                    Click="SeleccionarTodos_Click"
                    Content="Seleccionar todos"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Marca todos los proveedores visibles con el filtro actual." />
                <Button
                    x:Name="BotonDeseleccionarTodos"
                    Click="DeseleccionarTodos_Click"
                    Content="Deseleccionar todos"
                    Visibility="Collapsed" />
                <Button
                    x:Name="BotonEliminarSeleccionados"
                    Click="EliminarSeleccionados_Click"
                    Content="Eliminar seleccionados"
                    IsEnabled="False"
                    Visibility="Collapsed" />
                <Button
                    Click="Agregar_Click"
                    Content="Agregar proveedor"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="*" MinWidth="140" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="CajaBusqueda"
                    MinHeight="32"
                    MaxHeight="32"
                    VerticalAlignment="Center"
                    PlaceholderText="Buscar por nombre, RUC, empresa, banco, red, web o nota"
                    TextChanged="CajaBusqueda_TextChanged" />
                <ComboBox
                    x:Name="ComboCalificacion"
                    Grid.Column="1"
                    MinHeight="32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    PlaceholderText="Calificación"
                    SelectionChanged="Filtro_Changed" />
                <ComboBox
                    x:Name="ComboAnio"
                    Grid.Column="2"
                    MinHeight="32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    PlaceholderText="Año"
                    SelectionChanged="Periodo_Changed" />
            </Grid>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Opacity="0.75" Text="Mes de alta:" />
                <ScrollViewer
                    Grid.Column="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel x:Name="PanelMeses" Orientation="Horizontal" Spacing="4" />
                        <Button
                            VerticalAlignment="Center"
                            Click="TodosMeses_Click"
                            Content="Todos los meses" />
                        <ToggleButton
                            x:Name="ChipUltimos3"
                            VerticalAlignment="Center"
                            Click="AtajoMeses_Click"
                            Content="Últimos 3 meses"
                            Tag="3" />
                        <ToggleButton
                            x:Name="ChipUltimos6"
                            VerticalAlignment="Center"
                            Click="AtajoMeses_Click"
                            Content="Últimos 6 meses"
                            Tag="6" />
                        <ToggleButton
                            x:Name="ChipUltimos12"
                            VerticalAlignment="Center"
                            Click="AtajoMeses_Click"
                            Content="Último año"
                            Tag="12" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </StackPanel>

        <InfoBar
            x:Name="Barra"
            Grid.Row="2"
            IsClosable="True"
            IsOpen="False" />

        <Grid Grid.Row="3">
            <ListView
                x:Name="Lista"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,0,0,6" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ProveedorFila">
                        <Border Padding="12,10" Style="{StaticResource TarjetaKpiStyle}">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        Checked="MarcaProveedor_Changed"
                                        IsChecked="{x:Bind EstaMarcada, Mode=OneWay}"
                                        Tag="{x:Bind IdTexto}"
                                        Unchecked="MarcaProveedor_Changed"
                                        Visibility="{x:Bind MostrarMarca}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Nombre}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Opacity="0.55"
                                        Text="{x:Bind FechaTexto}" />
                                </Grid>

                                <TextBlock
                                    Grid.Row="1"
                                    FontSize="12"
                                    Opacity="0.72"
                                    Text="{x:Bind DetalleTexto}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTipService.ToolTip="{x:Bind DetalleTexto}" />

                                <Grid Grid.Row="2" ColumnSpacing="10" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="200" />
                                        <ColumnDefinition Width="*" MinWidth="200" />
                                    </Grid.ColumnDefinitions>
                                    <Grid ColumnSpacing="6" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" MinWidth="80" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            MinHeight="32"
                                            Padding="10,5,8,5"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            ItemTemplate="{StaticResource CanalDatoPlantilla}"
                                            ItemsSource="{x:Bind Canales}"
                                            Loaded="Canal1_Loaded"
                                            SelectionChanged="Canal1_SelectionChanged"
                                            Tag="{x:Bind IdTexto}" />
                                        <TextBox
                                            Grid.Column="1"
                                            MinHeight="32"
                                            Padding="10,5"
                                            VerticalAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            LostFocus="Dato1_LostFocus"
                                            PlaceholderText="{x:Bind Placeholder1}"
                                            Tag="{x:Bind IdTexto}"
                                            Text="{x:Bind Dato1, Mode=OneTime}"
                                            TextWrapping="NoWrap" />
                                        <Button
                                            Grid.Column="2"
                                            MinHeight="32"
                                            MinWidth="64"
                                            Padding="12,5"
                                            VerticalAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Click="AbrirCanal_Click"
                                            Content="Abrir" />
                                    </Grid>
                                    <Grid Grid.Column="1" ColumnSpacing="6" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" MinWidth="80" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            MinHeight="32"
                                            Padding="10,5,8,5"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            ItemTemplate="{StaticResource CanalDatoPlantilla}"
                                            ItemsSource="{x:Bind Canales}"
                                            Loaded="Canal2_Loaded"
                                            SelectionChanged="Canal2_SelectionChanged"
                                            Tag="{x:Bind IdTexto}" />
                                        <TextBox
                                            Grid.Column="1"
                                            MinHeight="32"
                                            Padding="10,5"
                                            VerticalAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            LostFocus="Dato2_LostFocus"
                                            PlaceholderText="{x:Bind Placeholder2}"
                                            Tag="{x:Bind IdTexto}"
                                            Text="{x:Bind Dato2, Mode=OneTime}"
                                            TextWrapping="NoWrap" />
                                        <Button
                                            Grid.Column="2"
                                            MinHeight="32"
                                            MinWidth="64"
                                            Padding="12,5"
                                            VerticalAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Click="AbrirCanal_Click"
                                            Content="Abrir" />
                                    </Grid>
                                </Grid>

                                <Grid Grid.Row="3" ColumnSpacing="8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" MinWidth="120" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        MinHeight="32"
                                        Padding="10,5,8,5"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        ItemsSource="{x:Bind Calificaciones}"
                                        Loaded="ComboCalificacion_Loaded"
                                        PlaceholderText="Calificación"
                                        SelectionChanged="Calificacion_SelectionChanged"
                                        Tag="{x:Bind IdTexto}" />
                                    <TextBox
                                        Grid.Column="1"
                                        MinHeight="32"
                                        Padding="10,5"
                                        VerticalAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        LostFocus="Notas_LostFocus"
                                        PlaceholderText="Notas"
                                        Tag="{x:Bind IdTexto}"
                                        Text="{x:Bind Notas, Mode=OneTime}"
                                        TextWrapping="NoWrap" />
                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Button
                                            MinHeight="32"
                                            MinWidth="76"
                                            Padding="14,5"
                                            VerticalAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Click="Editar_Click"
                                            Content="Editar"
                                            Tag="{x:Bind IdTexto}" />
                                        <Button
                                            MinHeight="32"
                                            MinWidth="84"
                                            Padding="14,5"
                                            VerticalAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Click="Eliminar_Click"
                                            Content="Eliminar"
                                            Tag="{x:Bind IdTexto}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                x:Name="TextoVacio"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.72"
                Text="Aún no hay proveedores."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Page>
