<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaFichas.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="28,16">
        <Grid
            MaxWidth="980"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="PanelKpis" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Style="{StaticResource TarjetaKpiBotonStyle}"
                    Click="AbrirCatalogo_Click"
                    ToolTipService.ToolTip="Abrir inventario">
                    <StackPanel Spacing="4">
                        <TextBlock Opacity="0.65" FontSize="12" Text="INVENTARIO" />
                        <TextBlock x:Name="KpiTotal" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Opacity="0.7" Text="Productos registrados" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="1"
                    Style="{StaticResource TarjetaKpiBotonStyle}"
                    Click="AbrirVencidos_Click"
                    ToolTipService.ToolTip="Ver materiales vencidos">
                    <StackPanel Spacing="4">
                        <TextBlock Opacity="0.65" FontSize="12" Foreground="{StaticResource VencidoBrush}" Text="VENCIDOS" />
                        <TextBlock x:Name="KpiVencidos" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource VencidoBrush}" />
                        <TextBlock Opacity="0.7" Text="Requieren retiro o baja" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="2"
                    Style="{StaticResource TarjetaKpiBotonStyle}"
                    Click="AbrirProximos_Click"
                    ToolTipService.ToolTip="Ver materiales por vencer">
                    <StackPanel Spacing="4">
                        <TextBlock Opacity="0.65" FontSize="12" Foreground="{StaticResource ProximoVencerBrush}" Text="POR VENCER" />
                        <TextBlock x:Name="KpiProximos" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource ProximoVencerBrush}" />
                        <TextBlock Opacity="0.7" Text="En los próximos 30 días" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="3"
                    Style="{StaticResource TarjetaKpiBotonStyle}"
                    Click="AbrirStockBajo_Click"
                    ToolTipService.ToolTip="Ver productos con stock bajo">
                    <StackPanel Spacing="4">
                        <TextBlock Opacity="0.65" FontSize="12" Text="STOCK BAJO" />
                        <TextBlock x:Name="KpiStockBajo" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Opacity="0.7" Text="En o bajo el mínimo" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    CornerRadius="12"
                    Click="AbrirCaducidad_Click">
                    <StackPanel Padding="12,10" Spacing="4">
                        <TextBlock Foreground="{StaticResource VencidoBrush}" FontWeight="SemiBold" Text="Alertas de caducidad" />
                        <TextBlock x:Name="DetalleVencidos" TextWrapping="Wrap" />
                        <TextBlock Opacity="0.7" Text="Abra vencimientos para dar seguimiento." />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    CornerRadius="12"
                    Click="AbrirCatalogo_Click">
                    <StackPanel Padding="12,10" Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="Actividad del inventario" />
                        <TextBlock x:Name="DetalleActividad" TextWrapping="Wrap" />
                        <TextBlock Opacity="0.7" Text="Abrir inventario para buscar o exportar." />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
